{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "adr-frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "date", "summary"],
  "properties": {
    "id": {"type": "string", "pattern": "^ADR-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 3},
    "status": {"enum": ["proposed", "accepted", "rejected", "superseded"]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "supersedes": {"type": ["string", "null"], "pattern": "^ADR-[0-9]{4}$"},
    "superseded_by": {"type": ["string", "null"], "pattern": "^ADR-[0-9]{4}$"},
    "body_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string", "minLength": 3, "maxLength": 80},
    "type": {"const": "explanation"}
  }
}
